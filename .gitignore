# Python bytecode and caches
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Virtual environments and local tool state
.venv/
.python-version

# Test, lint, typecheck, and benchmark caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.benchmarks/

# Build and packaging outputs
build/
dist/
*.egg-info/
.eggs/

# Coverage artifacts
.coverage
.coverage.*
htmlcov/

# MkDocs build output
site/
docs/notebooks/exports/
docs/notebooks/html/

# Notebook checkpoints
.ipynb_checkpoints/
__marimo__/

# Local environment files
.env

# Generated benchmark/results artifacts
benchmarks/results/
docs/benchmarks/results/

# Local tool directories
.claude/

# Generated model artifacts
colbert.*

# Generated project artifacts
data/raw/*
data/beir/*
data/processed/*
data/raw_expanded/*
data/trec-covid/*
data/logs/*
data/models/*
data/cache/*

# Preserve empty tracked directories
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/logs/.gitkeep
!data/cache/.gitkeep
!notebooks/.gitkeep

# Quarto: _freeze/ committed (forces-add) so CI never re-executes
# docs/notebooks/html/ committed via git add -f (generated, large)
# docs/notebooks/*.md stubs committed normally

#iipynb notebooks
notebooks/*.ipynb
